# Build-time only (read by scripts/*.mjs in Node; nothing here reaches the
# browser bundle). In CI/Cloudflare, set the same names as build env variables.
VITE_GOOGLE_SHEETS_SPREADSHEET_ID=
VITE_GOOGLE_SHEETS_SHEET_NAME=
VITE_GOOGLE_SHEETS_JKP_SHEET_NAME=
# Production builds also need GOOGLE_SERVICE_ACCOUNT_JSON (the service account's
# full JSON); locally scripts/stips-scraper/service-account.json is used.
